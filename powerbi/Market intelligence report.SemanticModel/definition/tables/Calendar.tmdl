	column 'Financial Quarter'
		lineageTag: 67c4af1a-5ea3-4d18-9d3a-1ffcebdb962f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Financial Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Is SP500 Trading Day' =
			
			VAR CurrentDate = 'Calendar'[Date]
			VAR TradingDayFlag =
			    CALCULATE(
			        MAX('market_base'[Is_SP500_Trading_Day]),
			        FILTER(
			            'market_base',
			            'market_base'[Date] = CurrentDate
			        )
			    )
			RETURN
			IF(
			    TradingDayFlag = 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 11e58e63-2e04-4b40-83a9-2d55b2688a70
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN('market_base'[Date]),
				        MAX('market_base'[Date])
				    ),
				
				    "Year", YEAR([Date]),
				
				    "Month", FORMAT([Date], "MMM"),
				
				    "Month Number", MONTH([Date]),
				
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				
				    "Financial Year Number",
				        IF(
				            MONTH([Date]) >= 4,
				            YEAR([Date]) + 1,
				            YEAR([Date])
				        ),
				
				    "Financial Year",
				        "FY" &
				        RIGHT(
				            FORMAT(
				                IF(
				                    MONTH([Date]) >= 4,
				                    YEAR([Date]) + 1,
				                    YEAR([Date])
				                ),
				                "0000"
				            ),
				            2
				        ),
				
				    "Financial Month",
				        IF(
				            MONTH([Date]) >= 4,
				            MONTH([Date]) - 3,
				            MONTH([Date]) + 9
				        ),
				
				    "Financial Quarter Number",
				        ROUNDUP(
				            DIVIDE(
				                IF(
				                    MONTH([Date]) >= 4,
				                    MONTH([Date]) - 3,
				                    MONTH([Date]) + 9
				                ),
				                3
				            ),
				            0
				        ),
				
				    "Financial Quarter",
				        "FY" &
				        RIGHT(
				            FORMAT(
				                IF(
				                    MONTH([Date]) >= 4,
				                    YEAR([Date]) + 1,
				                    YEAR([Date])
				                ),
				                "0000"
				            ),
				            2
				        )
				        &
				        "Q"
				        &
				        ROUNDUP(
				            DIVIDE(
				                IF(
				                    MONTH([Date]) >= 4,
				                    MONTH([Date]) - 3,
				                    MONTH([Date]) + 9
				                ),
				                3
				            ),
				            0
				        )
				)

	annotation PBI_Id = d1c5622869c842e8948af9365de93c21

